{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "headers": [
    {
      "source": "/installers/(.*)",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
